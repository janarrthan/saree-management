# Copy this file to .env and fill in the values. Never commit .env.

# Server
PORT=3000
DOMAIN=http://localhost:3000
SESSION_SECRET=a-long-random-string

# Database (MongoDB connection string)
PRODUCTION_DB=mongodb+srv://<user>:<password>@<cluster>/<db-name>

# Email (Brevo SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
BREVO_API_KEY=your-brevo-smtp-key
MAIL_FROM=sender@example.com
ORDER_NOTIF_EMAIL=orders@example.com

# Google Drive (OAuth2)
GD_CLIENT_ID=your-client-id.apps.googleusercontent.com
GD_CLIENT_SECRET=your-client-secret
GD_REDIRECT_URL=https://developers.google.com/oauthplayground
GD_REFRESH_TOKEN=your-refresh-token
GD_UPLOAD_PATH=drive-folder-id-for-product-uploads
GD_ORDERS_PATH=drive-folder-id-for-orders

# Initial admin account (used by the commented-out seed script in src/index.js)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
